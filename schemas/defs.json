{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "memoctl/defs.json",
  "title": "memoctl shared definitions",
  "description": "Not an output on its own. Shared definitions referenced by the log and CLI schemas. config.json is self-contained and embeds its own copies.",
  "$defs": {
    "repo_id": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?(:[1-9][0-9]{0,4})?(/(?!\\.\\.?(/|(?![\\s\\S])))[A-Za-z0-9._-]+)+(?![\\s\\S])",
      "description": "Lowercase host, optional port, one or more path segments (none `.` or `..`). Port 1 to 65535 is checked by the tool (the pattern allows 1 to 99999 digits-wise)."
    },
    "topic": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}(?![\\s\\S])"
    },
    "label": {
      "type": "string",
      "maxLength": 321,
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}=[A-Za-z0-9._:/#@+=,-]{0,256}(?![\\s\\S])",
      "description": "key=value, split at the first `=`."
    },
    "labels": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/label"
      },
      "maxItems": 32,
      "uniqueItems": true,
      "description": "A set, sorted by key then value in output. At most 8 per note by default (config limits.max_labels, up to 32)."
    },
    "kind_name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}(?![\\s\\S])",
      "description": "An author kind or `unknown`."
    },
    "note_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 999999999999999999,
      "description": "AUTOINCREMENT id; the grammar is [1-9][0-9]{0,17}."
    },
    "actor": {
      "type": "string",
      "pattern": "^(human|auto):[A-Za-z0-9._@/-]{1,64}(?![\\s\\S])",
      "description": "human:<user> or auto:<name>. Advisory."
    },
    "actor_source": {
      "enum": [
        "flag",
        "tty",
        "default"
      ]
    },
    "duration": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)?(ms|s|m|h|d)?(?![\\s\\S])",
      "description": "No unit means seconds."
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z(?![\\s\\S])",
      "description": "UTC, YYYY-MM-DDTHH:MM:SSZ."
    },
    "timestamp_ms": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z(?![\\s\\S])",
      "description": "UTC, YYYY-MM-DDTHH:MM:SS.mmmZ (log only)."
    },
    "sha256_64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
      "description": "SHA-256 of the body's UTF-8 bytes."
    },
    "sha256_16": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}(?![\\s\\S])",
      "description": "First 16 hex characters of a SHA-256."
    },
    "status": {
      "enum": [
        "live",
        "superseded",
        "expired"
      ]
    },
    "untrusted_text": {
      "type": "string",
      "x-untrusted": true,
      "description": "Text that came from a note. A consumer treats it as untrusted data."
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536,
      "x-untrusted": true,
      "description": "Untrusted. 1 to 8192 UTF-8 bytes by default (hard ceiling 65536 bytes)."
    },
    "tool": {
      "const": "memoctl"
    },
    "exit_code": {
      "enum": [
        0,
        1,
        2,
        10,
        12,
        13,
        20
      ],
      "description": "11, 21 and 22 are never used."
    },
    "warnings": {
      "type": "array",
      "items": {
        "enum": [
          "expires_capped",
          "kind_unknown"
        ]
      },
      "uniqueItems": true,
      "description": "Fixed strings; [] when none."
    },
    "refusal_reason": {
      "enum": [
        "repo_full",
        "store_full",
        "rate_limited",
        "supersede_mismatch",
        "already_superseded",
        "secret_detected",
        "unsafe_state",
        "cron_block_malformed"
      ],
      "description": "Reasons of exit 20."
    },
    "failure_reason": {
      "enum": [
        "db_unreadable",
        "db_locked",
        "db_corrupt",
        "schema_newer",
        "timeout",
        "crontab_failed"
      ],
      "description": "Reasons of exit 12 (code failed)."
    },
    "error_code": {
      "enum": [
        "usage",
        "config_invalid",
        "internal",
        "not_found",
        "failed",
        "needs_human",
        "refused"
      ]
    },
    "secret_class": {
      "enum": [
        "private_key",
        "github_token",
        "gitlab_token",
        "slack_token",
        "aws_key_id",
        "npm_token",
        "anthropic_key",
        "mask_env"
      ]
    },
    "error_details": {
      "type": "object",
      "properties": {
        "field": {
          "type": "string",
          "maxLength": 4096,
          "description": "A field name (usage: [a-z_-]{1,32}); for config_invalid a key, `home` or a path."
        },
        "line": {
          "type": "integer",
          "minimum": 1,
          "description": "Line of refused text."
        },
        "class": {
          "type": "string",
          "pattern": "^[a-z0-9_]{1,32}(?![\\s\\S])",
          "description": "Class of refused text, or the secret class on secret_detected."
        },
        "limit": {
          "type": "integer",
          "minimum": 0,
          "description": "The limit that was hit (repo_full, store_full)."
        },
        "retry_after_s": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/error_code"
        },
        "message": {
          "type": "string",
          "maxLength": 2048,
          "description": "A fixed string of the tool; never a note text, exception text or input value."
        },
        "reason": {
          "oneOf": [
            {
              "anyOf": [
                {
                  "$ref": "#/$defs/refusal_reason"
                },
                {
                  "$ref": "#/$defs/failure_reason"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "details": {
          "oneOf": [
            {
              "$ref": "#/$defs/error_details"
            },
            {
              "type": "null"
            }
          ]
        },
        "retryable": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "True when the same call may succeed later (db_locked, timeout); false otherwise; null when it does not apply."
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "code": {
                "enum": [
                  "refused"
                ]
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "$ref": "#/$defs/refusal_reason"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "enum": [
                  "failed"
                ]
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "$ref": "#/$defs/failure_reason"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "enum": [
                  "usage",
                  "config_invalid",
                  "internal",
                  "not_found",
                  "needs_human"
                ]
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "reason": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reason": {
                "enum": [
                  "db_locked",
                  "timeout"
                ]
              }
            },
            "required": [
              "reason"
            ]
          },
          "then": {
            "properties": {
              "retryable": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "allOf": [
              {
                "properties": {
                  "code": {
                    "enum": [
                      "failed"
                    ]
                  }
                },
                "required": [
                  "code"
                ]
              },
              {
                "not": {
                  "properties": {
                    "reason": {
                      "enum": [
                        "db_locked",
                        "timeout"
                      ]
                    }
                  },
                  "required": [
                    "reason"
                  ]
                }
              }
            ]
          },
          "then": {
            "properties": {
              "retryable": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reason": {
                "enum": [
                  "rate_limited"
                ]
              }
            },
            "required": [
              "reason"
            ]
          },
          "then": {
            "required": [
              "details"
            ],
            "properties": {
              "details": {
                "type": "object",
                "required": [
                  "retry_after_s"
                ],
                "properties": {
                  "retry_after_s": {
                    "type": "number"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reason": {
                "enum": [
                  "secret_detected"
                ]
              }
            },
            "required": [
              "reason"
            ]
          },
          "then": {
            "required": [
              "details"
            ],
            "properties": {
              "details": {
                "type": "object",
                "required": [
                  "class"
                ],
                "properties": {
                  "class": {
                    "$ref": "#/$defs/secret_class"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reason": {
                "enum": [
                  "repo_full",
                  "store_full"
                ]
              }
            },
            "required": [
              "reason"
            ]
          },
          "then": {
            "required": [
              "details"
            ],
            "properties": {
              "details": {
                "type": "object",
                "required": [
                  "limit"
                ],
                "properties": {
                  "limit": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "enum": [
                  "usage"
                ]
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "required": [
              "details"
            ],
            "properties": {
              "details": {
                "type": "object",
                "required": [
                  "field"
                ],
                "properties": {
                  "field": {
                    "pattern": "^[a-z_-]{1,32}(?![\\s\\S])"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "enum": [
                  "config_invalid"
                ]
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "required": [
              "details"
            ],
            "properties": {
              "details": {
                "type": "object",
                "required": [
                  "field"
                ]
              }
            }
          }
        }
      ]
    }
  }
}
