{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "memoctl/cli/show.json",
  "title": "show output",
  "description": "Printed with --json on exit 0: one note in full, whatever its status. body is untrusted.",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "../defs.json#/$defs/note_id"
    },
    "repo": {
      "$ref": "../defs.json#/$defs/repo_id",
      "x-untrusted": true
    },
    "topic": {
      "$ref": "../defs.json#/$defs/topic",
      "x-untrusted": true
    },
    "kind": {
      "$ref": "../defs.json#/$defs/kind_name",
      "x-untrusted": true
    },
    "labels": {
      "$ref": "../defs.json#/$defs/labels",
      "x-untrusted": true
    },
    "body": {
      "$ref": "../defs.json#/$defs/body"
    },
    "size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65536
    },
    "created": {
      "$ref": "../defs.json#/$defs/timestamp"
    },
    "expires": {
      "$ref": "../defs.json#/$defs/timestamp"
    },
    "status": {
      "$ref": "../defs.json#/$defs/status"
    },
    "superseded_by": {
      "oneOf": [
        {
          "$ref": "../defs.json#/$defs/note_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "body_sha256": {
      "$ref": "../defs.json#/$defs/sha256_64"
    },
    "supersedes": {
      "oneOf": [
        {
          "$ref": "../defs.json#/$defs/note_id"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "repo",
    "topic",
    "kind",
    "labels",
    "body",
    "size",
    "created",
    "expires",
    "status",
    "superseded_by",
    "body_sha256",
    "supersedes"
  ],
  "additionalProperties": false
}
