{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "memoctl/cli/add.json",
  "title": "add output",
  "description": "Printed with --json on exit 0 (created, existing or dry run). id is null exactly when dry_run is true: a dry run runs only the checks that need no state (dedupe, the supersede checks and the limits are not run), so created is true, supersedes is the requested target unchecked and expires is the call's own lifetime (never expires_extended). created is false when a retry already landed (the output is the stored live note; this call's --expires is not applied). Errors print the error envelope.",
  "type": "object",
  "properties": {
    "id": {
      "oneOf": [
        {
          "$ref": "../defs.json#/$defs/note_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "created": {
      "type": "boolean"
    },
    "dry_run": {
      "type": "boolean"
    },
    "repo": {
      "$ref": "../defs.json#/$defs/repo_id",
      "x-untrusted": true
    },
    "topic": {
      "$ref": "../defs.json#/$defs/topic",
      "x-untrusted": true
    },
    "kind": {
      "$ref": "../defs.json#/$defs/kind_name",
      "x-untrusted": true
    },
    "labels": {
      "$ref": "../defs.json#/$defs/labels",
      "x-untrusted": true
    },
    "expires": {
      "$ref": "../defs.json#/$defs/timestamp"
    },
    "supersedes": {
      "oneOf": [
        {
          "$ref": "../defs.json#/$defs/note_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65536
    },
    "body_sha256": {
      "$ref": "../defs.json#/$defs/sha256_64"
    },
    "warnings": {
      "$ref": "../defs.json#/$defs/warnings"
    }
  },
  "required": [
    "id",
    "created",
    "dry_run",
    "repo",
    "topic",
    "kind",
    "labels",
    "expires",
    "supersedes",
    "size",
    "body_sha256",
    "warnings"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "id": {
            "type": "null"
          }
        },
        "required": [
          "id"
        ]
      },
      "then": {
        "properties": {
          "dry_run": {
            "const": true
          },
          "created": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "dry_run": {
            "const": true
          }
        },
        "required": [
          "dry_run"
        ]
      },
      "then": {
        "properties": {
          "id": {
            "type": "null"
          },
          "created": {
            "const": true
          },
          "warnings": {
            "items": {
              "enum": [
                "expires_capped",
                "kind_not_shown"
              ]
            }
          }
        }
      }
    }
  ]
}
