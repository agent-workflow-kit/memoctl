{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "memoctl/cli/prune.json",
  "title": "prune output",
  "description": "Printed with --json on exit 0: counts (also for --dry-run, which changes nothing; remaining is the number of notes after the run), or {outcome: already_running} when another prune holds the write lock.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "expired": {
          "type": "integer",
          "minimum": 0
        },
        "future": {
          "type": "integer",
          "minimum": 0
        },
        "reinstated": {
          "type": "integer",
          "minimum": 0
        },
        "remaining": {
          "type": "integer",
          "minimum": 0
        },
        "dry_run": {
          "type": "boolean"
        }
      },
      "required": [
        "expired",
        "future",
        "reinstated",
        "remaining",
        "dry_run"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "already_running"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    }
  ]
}
