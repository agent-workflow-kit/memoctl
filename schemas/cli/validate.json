{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "memoctl/cli/validate.json",
  "title": "validate output",
  "description": "Printed with --json, on success and failure (the only stdout). Checks run in order config, state_dir, database, schema; a failed check ends the run and later checks are omitted. Exit 0 when ok, else 2 (config_invalid), 20 (unsafe_state) or 12 (the others). A deadline (exit 12 timeout) and argv usage errors print the error envelope instead.",
  "type": "object",
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "checks": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "enum": [
              "config",
              "state_dir",
              "database",
              "schema"
            ]
          },
          "ok": {
            "type": "boolean"
          },
          "reason": {
            "oneOf": [
              {
                "enum": [
                  "config_invalid",
                  "unsafe_state",
                  "db_unreadable",
                  "db_locked",
                  "db_corrupt",
                  "schema_newer"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "type": "string",
            "maxLength": 1024,
            "description": "A fixed string of the tool, not part of the contract."
          }
        },
        "required": [
          "name",
          "ok",
          "reason",
          "message"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "ok": {
                  "const": true
                }
              },
              "required": [
                "ok"
              ]
            },
            "then": {
              "properties": {
                "reason": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "reason": {
                  "type": "string"
                }
              }
            }
          }
        ]
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "enum": [
          "unsafe_filesystem"
        ]
      },
      "uniqueItems": true
    }
  },
  "required": [
    "ok",
    "checks",
    "warnings"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          }
        },
        "required": [
          "ok"
        ]
      },
      "then": {
        "properties": {
          "checks": {
            "items": {
              "properties": {
                "ok": {
                  "const": true
                }
              }
            }
          }
        }
      }
    }
  ]
}
