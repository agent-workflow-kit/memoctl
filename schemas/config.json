{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "memoctl/config.json",
  "title": "memoctl config",
  "description": "Merged config after config.yaml and config.d/*.yaml. Self-contained (no external $ref). There are no environment overrides. Every key is optional: a missing key takes its default. Range checks of duration strings and cross-key checks (live_per_repo at most total) are made by the tool.",
  "type": "object",
  "properties": {
    "kind_env": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,63}(?![\\s\\S])",
      "default": "CSESSION_KIND",
      "description": "Name of the environment variable that holds the claimed author kind."
    },
    "mask_env": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{0,63}(?![\\s\\S])"
      },
      "default": [],
      "description": "Names of environment variables whose current values add refuses to store."
    },
    "retention": {
      "$ref": "#/$defs/retention"
    },
    "limits": {
      "$ref": "#/$defs/limits"
    },
    "context": {
      "$ref": "#/$defs/context"
    },
    "repos": {
      "type": "object",
      "default": {},
      "propertyNames": {
        "type": "string",
        "maxLength": 255,
        "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?(:[1-9][0-9]{0,4})?(/(?!\\.\\.?(/|(?![\\s\\S])))[A-Za-z0-9._-]+)+(?![\\s\\S])"
      },
      "additionalProperties": {
        "$ref": "#/$defs/repo_override"
      },
      "description": "Per-repo overrides keyed by repo id."
    }
  },
  "additionalProperties": false,
  "$defs": {
    "retention": {
      "type": "object",
      "properties": {
        "max_age": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 3600,
              "maximum": 31536000
            },
            {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?(ms|s|m|h|d)?(?![\\s\\S])"
            }
          ],
          "default": "30d",
          "description": "Default lifetime of a note and the cap on --expires; 1 hour to 365 days. A number of seconds or a duration string; the range of a string is checked by the tool."
        },
        "superseded_grace": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 31536000
            },
            {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?(ms|s|m|h|d)?(?![\\s\\S])"
            }
          ],
          "default": "7d",
          "description": "How long a superseded note stays before prune deletes it; 0 to 365 days. A number of seconds or a duration string; the range of a string is checked by the tool."
        }
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_body_bytes": {
          "type": "integer",
          "minimum": 256,
          "maximum": 65536,
          "default": 8192,
          "description": "Body limit in bytes."
        },
        "max_labels": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32,
          "default": 8,
          "description": "Labels per note."
        },
        "live_per_repo": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000,
          "default": 200,
          "description": "Live notes per repo."
        },
        "total": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000,
          "default": 5000,
          "description": "Notes in the store, every status."
        },
        "adds_per_window": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000,
          "default": 20,
          "description": "Adds per repo per window."
        },
        "window": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 60,
              "maximum": 86400
            },
            {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?(ms|s|m|h|d)?(?![\\s\\S])"
            }
          ],
          "default": "10m",
          "description": "The rate window; 1 minute to 1 day. A number of seconds or a duration string; the range of a string is checked by the tool."
        }
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "properties": {
        "author_kinds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}(?![\\s\\S])"
          },
          "default": [
            "implement",
            "draft-ticket",
            "audit",
            "improve"
          ],
          "description": "Allow list of author kinds whose notes context may show."
        },
        "max_chars": {
          "type": "integer",
          "minimum": 500,
          "maximum": 9000,
          "default": 8000,
          "description": "Budget in UTF-16 code units."
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 500,
          "maximum": 65536,
          "default": 15000,
          "description": "Budget in UTF-8 bytes."
        },
        "max_notes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20,
          "description": "Notes per block."
        },
        "max_per_topic": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "default": 2,
          "description": "Notes per topic in a block."
        },
        "max_kind_share": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 1,
          "default": 0.5,
          "description": "Share of max_chars one kind may take in the first pass."
        },
        "note_max_chars": {
          "type": "integer",
          "minimum": 100,
          "maximum": 8192,
          "default": 2000,
          "description": "Characters of one note shown."
        },
        "deadline": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 1,
              "maximum": 10
            },
            {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?(ms|s|m|h|d)?(?![\\s\\S])"
            }
          ],
          "default": "2s",
          "description": "The context deadline; 1s to 10s. A number of seconds or a duration string; the range of a string is checked by the tool."
        }
      },
      "additionalProperties": false
    },
    "repo_override": {
      "type": "object",
      "description": "Per-repo overrides: only retention, limits and context.",
      "properties": {
        "retention": {
          "$ref": "#/$defs/retention"
        },
        "limits": {
          "$ref": "#/$defs/limits"
        },
        "context": {
          "$ref": "#/$defs/context"
        }
      },
      "additionalProperties": false
    }
  }
}
